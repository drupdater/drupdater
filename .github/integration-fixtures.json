[
  {
    "name": "drupal-cms",
    "description": "Drupal CMS, core held a minor behind so every run has updates",
    "repository_url": "https://github.com/drupdater/test-drupal-cms.git",
    "branch": "main",
    "expect": {
      "normal": {
        "status": [
          "success"
        ],
        "min_packages": 1,
        "packages_match": [
          "^drupal/core"
        ],
        "forbid_actions": [
          "Downgrade"
        ],
        "phases": [
          "acquire working copy",
          "preflight",
          "composer install",
          "baseline site install",
          "update shared code",
          "site update",
          "render merge request"
        ],
        "addons": [
          "update_hooks",
          "unsupported_modules",
          "composer_audit",
          "code_beautifier",
          "deprecations_remover",
          "translations_updater"
        ]
      },
      "security": {
        "status": [
          "success"
        ],
        "min_packages": 1,
        "audit_fixed_min": 1,
        "forbid_actions": [
          "Downgrade"
        ],
        "phases": [
          "acquire working copy",
          "preflight",
          "composer install",
          "baseline site install",
          "update shared code",
          "site update",
          "render merge request"
        ],
        "addons": [
          "composer_audit",
          "unsupported_modules",
          "update_hooks"
        ]
      }
    }
  },
