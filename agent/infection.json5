{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 30,
    "logs": {
        "text": "build/infection/infection.log",
        "summaryJson": "build/infection/summary.json"
    },
    "mutators": {
        "@default": true,
        "CastString": {
            "ignore": [
                // Equivalent: PHP turns a numeric string key back into an int; the cast is for PHPStan.
                "Drupdater\\Agent\\Json::map"
            ]
        }
    }
}
