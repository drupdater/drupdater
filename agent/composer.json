{
    "name": "drupdater/agent",
    "description": "Answers drupdater's questions about a project from inside its own Composer, as `composer drupdater:*` commands.",
    "type": "composer-plugin",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "composer-plugin-api": "^2.6",
        "ion-bazan/composer-diff": "^2.4",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "composer/composer": "~2.10.0",
        "infection/infection": "^0.35.10",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Drupdater\\Agent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupdater\\Agent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "Drupdater\\Agent\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "ion-bazan/composer-diff": false,
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
